{
  "name": "@nehsamud/web",
  "version": "0.1.0",
  "private": true,
  "description": "The NehsaMUD app — plays Exploration, PVE, and PVP, and is the surface the unit, integration, and e2e tiers drive.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
