{
  "name": "nehsamud-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Text-based MUD — the engine, its Postgres schema, and the app that plays every mode.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @nehsamud/web",
    "dev:all": "node scripts/dev.mjs",
    "dev:engine": "npm run dev --workspace @nehsamud/engine",
    "build": "npm run build --workspace @nehsamud/engine-db && npm run build --workspace @nehsamud/engine && npm run build --workspace @nehsamud/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "prisma:generate": "npm run prisma:generate --workspace @nehsamud/engine-db",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @nehsamud/engine-db",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @nehsamud/engine-db",
    "seed": "npm run seed --workspace @nehsamud/engine"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
