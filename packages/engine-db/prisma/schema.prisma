// Prisma schema for the NehsaMUD Postgres tables. All tables live in
// the `mud` Postgres schema (the `@@schema("mud")` annotation on each
// model; multi-schema is built in since Prisma 7).
//
// THE VOCABULARY HERE IS DELIBERATELY GENRE-FREE. One engine serves
// worlds that share nothing thematically — a fantasy MUD and a virtual
// senior-care centre — and a column called `race` or a table called
// `monster` is a fantasy assumption compiled into every deployment.
// So the schema names MECHANICS and content packs supply NOUNS:
//
//   a thing that can be fought       → `hostile`, not `monster`
//   an axis a character is built on  → `character_option_group`,
//                                      not `race` and `class`
//   what kind of thing something is  → `tags`, not `alignment`/`mob_type`
//   who owns a character             → an opaque `owner_id`, not an FK
//                                      into some host's user table
//
// A pack declares its own axes: the fantasy pack ships Race and Class,
// a care centre may ship Background and Room, and a minimal pack may
// ship none at all. See docs/prd/PRD-0002-content-packs.md (R6–R9).
//
// `schema-vocabulary.test.ts` enforces the rule on this file, because
// "no genre words" is the kind of thing review agrees with and then
// misses. Doc comments are exempt — this one has to be able to say
// "race" to explain why there isn't one.
//
// Catalog tables (Room, Item, Hostile, Npc, the option groups) are
// seeded from a pack and treated as read-mostly. Character state
// (position, hp, inventory) is written by the engine at runtime.

generator client {
  // multiSchema is built in to Prisma 7+; the preview-features flag
  // used in 6.x is no longer needed (Prisma warns when present).
  provider = "prisma-client-js"
  // Generate INTO this package, not the workspace-root
  // `node_modules/.prisma/client`. The hopper-db package also uses
  // a Prisma generator targeting the workspace-root location; if we
  // shared that path, whichever package ran `prisma generate` last
  // would clobber the other's models. Keeping each package's client
  // local lets both schemas coexist.
  // Lives at the package root so the same relative path
  // `../generated/client/index.js` resolves correctly from both
  // src/index.ts (during dev) and dist/index.js (after tsc build).
  // The `src/generated/` variant fails post-build because
  // dist/generated/ never gets populated.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["mud", "public"]
}

/// One player character. A single owner can hold several (the login
/// flows offer one today, but nothing here assumes that). Position is
/// tracked via roomId; null means the character isn't currently spawned.
model MudPlayer {
  id          String   @id @default(uuid()) @db.Uuid
  /// The account that owns this character, as an OPAQUE id.
  ///
  /// Deliberately not a foreign key. It referenced `public.user(user_id)`,
  /// a table this package does not own — which blocked a standalone
  /// deployment twice over: its database could not be migrated, and its
  /// characters could not be created. The host decides what this id means;
  /// the engine never interprets it.
  ownerId     String   @map("owner_id") @db.Uuid
  name        String   @unique @db.VarChar(50)
  /// Current room. Null when the character hasn't spawned yet or is
  /// in a transient state. Updated on every `move`.
  roomId      String?  @map("room_id") @db.Uuid
  level       Int      @default(1)
  experience  Int      @default(0)
  currentHp   Int      @default(10) @map("current_hp")
  maxHp       Int      @default(10) @map("max_hp")
  /// Stats — the seven core attributes. Values come from the chosen
  /// options' modifiers applied at creation time; the columns store the
  /// post-modifier values for fast reads.
  strength     Int @default(10)
  intelligence Int @default(10)
  wisdom       Int @default(10)
  charisma     Int @default(10)
  constitution Int @default(10)
  dexterity    Int @default(10)
  luck         Int @default(10)
  /// Optional cosmetic appearance fields. Nullable throughout — the
  /// creation flows in use today ship no appearance pickers.
  bodyType        String?  @map("body_type") @db.VarChar(50)
  sex             String?  @db.VarChar(50)
  eyeColor        String?  @map("eye_color") @db.VarChar(50)
  eyeBrow         String?  @map("eye_brow") @db.VarChar(50)
  hairColor       String?  @map("hair_color") @db.VarChar(50)
  hairStyle       String?  @map("hair_style") @db.VarChar(50)
  facialHairStyle String?  @map("facial_hair_style") @db.VarChar(50)
  /// Argon2 hash of the player's PIN. Optional — guest characters
  /// have no PIN.
  pinHash    String?  @map("pin_hash") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  /// Last time the player was seen in-game. Used for "online players"
  /// queries and stale-character cleanup. Null until first login.
  lastSeenAt DateTime? @map("last_seen_at")

  room      MudRoom?          @relation(fields: [roomId], references: [id])
  inventory MudInventory[]
  /// What this character was built from — one row per option group the
  /// pack declares. Empty for a pack with no character-creation axes,
  /// which is a legitimate world rather than a broken character.
  options   MudPlayerOption[]

  @@index([ownerId])
  @@map("player")
  @@schema("mud")
}

/// An axis a character is built on, declared by the content pack.
///
/// The fantasy pack declares two — Race and Class. A care-centre pack may
/// declare Background and Room, or none at all. The engine knows only that
/// a character picks one option per group; what the groups MEAN is content.
///
/// This replaced two hardcoded tables, `race` and `class`, which forced
/// every world to have exactly those two axes and no others.
model MudCharacterOptionGroup {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable key the pack and the wire protocol use, e.g. "race".
  /// Lowercase; the application-layer reference for this group.
  key         String   @unique @db.VarChar(50)
  /// What a player is shown, e.g. "Race".
  name        String   @unique @db.VarChar(50)
  description String
  /// Order the creation flow asks in. Ties broken by `key`, so the
  /// order is total and a player is asked the same questions in the
  /// same sequence every time.
  position    Int      @default(0)
  /// Whether a character MUST pick from this group. A pack can declare
  /// an optional axis; creation then succeeds without it.
  required    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  options       MudCharacterOption[]
  playerOptions MudPlayerOption[]

  @@map("character_option_group")
  @@schema("mud")
}

/// One choice within a group — "Elf" within Race, "Night nurse" within Staff.
///
/// Carries the attribute modifiers applied at creation. Every option in
/// every group contributes, so a pack with three axes stacks three sets of
/// modifiers and a pack with none produces a character of straight base
/// attributes.
model MudCharacterOption {
  id                       String   @id @default(uuid()) @db.Uuid
  groupId                  String   @map("group_id") @db.Uuid
  /// Lowercase slug — the wire value the client and server compare on.
  /// Unique within its group, not globally: two packs' groups may both
  /// reasonably offer "standard".
  slug                     String   @db.VarChar(50)
  name                     String   @db.VarChar(50)
  description              String
  abilities                String[]
  directives               String[]
  /// Attribute modifiers applied at character creation.
  strengthMod              Int      @default(0) @map("strength_mod")
  intelligenceMod          Int      @default(0) @map("intelligence_mod")
  wisdomMod                Int      @default(0) @map("wisdom_mod")
  charismaMod              Int      @default(0) @map("charisma_mod")
  constitutionMod          Int      @default(0) @map("constitution_mod")
  dexterityMod             Int      @default(0) @map("dexterity_mod")
  luckMod                  Int      @default(0) @map("luck_mod")
  baseExperienceAdjustment Int      @default(0) @map("base_experience_adjustment")
  /// Whether a player may choose this. False for an option that exists
  /// only as flavour or is retired but still referenced by characters.
  selectable               Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  group         MudCharacterOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  playerOptions MudPlayerOption[]

  @@unique([groupId, slug])
  @@unique([groupId, name])
  @@index([groupId])
  @@map("character_option")
  @@schema("mud")
}

/// What one character picked on one axis.
///
/// The primary key is (player, group) rather than (player, option): that is
/// what makes "one choice per axis" a database rule instead of a convention
/// the create path is trusted to keep. A second insert for the same group
/// is a constraint violation, not a character with two races.
model MudPlayerOption {
  playerId String @map("player_id") @db.Uuid
  groupId  String @map("group_id") @db.Uuid
  optionId String @map("option_id") @db.Uuid

  player MudPlayer               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  group  MudCharacterOptionGroup @relation(fields: [groupId], references: [id])
  option MudCharacterOption      @relation(fields: [optionId], references: [id])

  @@id([playerId, groupId])
  @@index([optionId])
  @@map("player_option")
  @@schema("mud")
}

/// World room. The upstream Python `room_registry` mirrors this on
/// boot; rooms are persisted so map/exit edits survive restarts.
/// Exits are stored as JSON: { north: roomId, south: roomId, … }.
model MudRoom {
  id          String   @id @default(uuid()) @db.Uuid
  /// Code reference. Stable enum-style name from
  /// core.enums.rooms.RoomEnum so the Python side can lookup spawn
  /// rooms without UUID hardcoding.
  enumKey     String   @unique @map("enum_key") @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String
  exits       Json     @default("{}")
  /// AI-generated room art filename when present.
  imageName   String?  @map("image_name") @db.VarChar(255)
  /// Environment tag (e.g. "townsmee", "forest", "cave"). Originally
  /// a separate `environments` table in the Python schema; collapsed
  /// to a denormalized column for the focused rewrite — the table
  /// only ever held ~10 rows used for ambient-event selection.
  /// Region this room belongs to (`AreaFixture.key`), e.g. "townsmee".
  ///
  /// Distinct from `environment`, which is a per-room art hint: two rooms in
  /// one area can look nothing alike. Defaulted so the column is additive
  /// over rooms seeded before areas existed.
  area        String   @default("townsmee") @db.VarChar(64)
  environment String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  players MudPlayer[]
  items   MudRoomItem[]
  npcs    MudNpc[]

  @@map("room")
  @@schema("mud")
}

/// Item catalog. Items in a player's inventory or in a room are
/// instances pointing at this row; equipment slot + damage values
/// come from here.
model MudItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  description String
  /// Matches MudItemType in hopper-play (numeric IntEnum mirrored
  /// from the Python `core.enums.item_type.ItemType`).
  type        Int
  /// For weapons: base damage. For armor: damage reduction. Null
  /// otherwise.
  baseValue   Int?     @map("base_value")
  weight      Int      @default(1)
  /// AI-generated item art filename when present.
  imageName   String?  @map("image_name") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  playerInventories MudInventory[]
  roomDrops         MudRoomItem[]

  @@map("item")
  @@schema("mud")
}

/// A specific item in a specific player's inventory. The Python world
/// service writes here on every `pickup`/`drop`/`give` event.
model MudInventory {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  /// Stack count for stackable items (potions, gold coins). 1 for
  /// uniques.
  quantity  Int      @default(1)
  /// True when this is the player's currently-equipped instance of
  /// the item's slot. Mutually exclusive across a player's items in
  /// the same MudItem.type bucket (no DB enforcement today; the
  /// Python equip handler manages the invariant).
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  player MudPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item   MudItem   @relation(fields: [itemId], references: [id])

  @@index([playerId])
  @@map("inventory")
  @@schema("mud")
}

/// An item dropped in a room. Persists across restarts so a town
/// square littered with items survives a server reboot.
model MudRoomItem {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  quantity  Int      @default(1)
  /// Concealed from `look`, findable only by `search`.
  ///
  /// A flag on the placement rather than on the item, because the same item
  /// can lie in plain sight in one room and be stashed in another — hidden
  /// is a fact about where a thing is, not about what it is.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  room MudRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  item MudItem @relation(fields: [itemId], references: [id])

  @@index([roomId])
  @@map("room_item")
  @@schema("mud")
}

/// Something that can be fought.
///
/// Called `monster` until PRD-0002 R6: the mechanic is "a thing that can
/// be fought", and what that thing IS belongs to the pack. A care-centre
/// world runs Exploration mode and simply leaves this table empty.
///
/// Spawned by the world bootstrap; each fight references this row for base
/// stats. Per-fight state (current hp, room) lives in memory rather than
/// here, so instances respawn from the catalog and there are no
/// fight-instance rows to clean up.
model MudHostile {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String
  /// Tier / difficulty for spawn selection.
  level       Int      @default(1)
  baseHp      Int      @map("base_hp")
  baseDamage  Int      @map("base_damage")
  experience  Int      @default(0)
  /// Pack-defined labels, e.g. ["undead", "evil"].
  ///
  /// Replaced two columns, `alignment` and `mob_type`, whose four and five
  /// permitted values were a fantasy bestiary's taxonomy hardcoded into
  /// every world. A tag list lets a pack classify its own content without
  /// the engine having an opinion about what the categories are — and the
  /// engine reads none of them today, which is the point: they are content.
  tags        String[]
  /// Generated art filename when present.
  imageName   String?  @map("image_name") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("hostile")
  @@schema("mud")
}

/// Someone a player can talk to. Occupies a fixed room; the dialog
/// system reads `intelligenceMode` to decide whether to canned-reply or
/// send the prompt to the text-generation provider. Distinct from
/// MudHostile because the behaviour axis is "dialog + economy" rather
/// than "combat" — a world may have these and no hostiles at all.
model MudNpc {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(255)
  description       String
  /// Anchor room. Null when the NPC isn't currently placed in the
  /// world — the seed sets this; runtime placement is managed by
  /// the Phase 5 NPC service.
  roomId            String?  @map("room_id") @db.Uuid
  /// "he" | "she" | "they" — referenced by canned-reply templating.
  pronoun           String   @default("they") @db.VarChar(10)
  /// Pack-defined labels, same as MudHostile.tags. Was an `alignment`
  /// column restricted to a fantasy morality scale.
  tags              String[]
  /// "canned" | "ai" — canned uses the static `dialogLines` array;
  /// ai routes through the text-generation provider (Phase 6) and
  /// falls back to canned when the provider is unavailable per
  /// /capabilities.
  intelligenceMode  String   @default("canned") @map("intelligence_mode") @db.VarChar(20)
  /// Static reply lines used by the canned dialog path. Cycled
  /// in order when the player says hello.
  dialogLines       String[] @map("dialog_lines")
  /// Topics the NPC is willing to talk about, used as keywords by
  /// the dialog matcher.
  interests         String[]
  /// AI-generated NPC art filename when present.
  imageName         String?  @map("image_name") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  room MudRoom? @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@map("npc")
  @@schema("mud")
}
