{
  "name": "@nehsamud/engine-db",
  "version": "0.1.0",
  "description": "Prisma schema and client for the NehsaMUD Postgres tables. Tables live in the `mud` schema (multi-schema).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "generated"
  ],
  "scripts": {
    "build": "npx prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "jest --passWithNoTests",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:status": "prisma migrate status --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:bootstrap": "psql \"$MUD_DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/standalone-bootstrap.sql"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "prisma": "^7.8.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
