{
  "name": "@nehsamud/engine",
  "version": "0.1.0",
  "description": "The NehsaMUD game engine — world, commands, combat, and the WebSocket/HTTP surface. Runs in one of three modes: exploration, pve, pvp.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./modes": {
      "types": "./dist/game-mode.d.ts",
      "import": "./dist/game-mode.js"
    },
    "./character": {
      "types": "./dist/character.d.ts",
      "import": "./dist/character.js"
    },
    "./catalog": {
      "types": "./dist/seed/fixtures/index.d.ts",
      "import": "./dist/seed/fixtures/index.js"
    }
  },
  "bin": {
    "nehsamud-engine": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed/run.ts",
    "test": "npm run test:unit",
    "test:unit": "jest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nehsamud/engine-db": "*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
